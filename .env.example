APP_NAME=facial-recognition-module
APP_PORT=8003
DEBUG=true

# Base de datos (SQLite por defecto para fácil desarrollo, soporta PostgreSQL)
DATABASE_URL=sqlite:///./data/facial_recognition.db

# Reconocimiento facial
FACE_DET_SIZE=640
SIMILARITY_THRESHOLD=0.45
MAX_FACES_PER_FRAME=20
MODEL_NAME=buffalo_l

# Almacenamiento e índice FAISS
FAISS_INDEX_PATH=./data/faiss_index.bin
VETADOS_DIR=./data/vetados
SCREENSHOTS_DIR=./data/screenshots

# CORS (Orígenes permitidos separados por coma o *)
ALLOWED_ORIGINS=*

